# App base URL for server-side fetches (defaults to http://localhost:3000 in development)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# The Movie Database (TMDB) API Read Access Token
TMDB_ACCESS_TOKEN=

# OMDb API Key (for IMDb and Rotten Tomatoes ratings)
OMDB_API_KEY=

# Anthropic API Key (for audience consensus AI summarizer)
ANTHROPIC_API_KEY=

# Optional: Upstash Redis for distributed cache (falls back to in-memory store if omitted)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
